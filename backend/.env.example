DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Render/Supabase aliases are accepted by deployment platforms, but DB_URL is the preferred Spring value.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=REPLACE_WITH_SUPABASE_PASSWORD
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=REPLACE_WITH_SUPABASE_PASSWORD
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate
V2_FEATURES_ENABLED=false
V3_FEATURES_ENABLED=false
EXECUTION_CLEAN_THRESHOLD=75
EXECUTION_FAST_REENTRY_MINUTES=7
EXECUTION_FAST_REENTRY_BASELINE_RATIO=0.50
EXECUTION_RISK_INCREASE_PERCENT=25
EXECUTION_SIZE_INCREASE_PERCENT=25
EXECUTION_DROP_POINTS=15
EXECUTION_MIN_PRESSURE_POINT_SAMPLES=8
EXECUTION_MIN_PATTERN_OCCURRENCES=3
EXECUTION_LOOKBACK_DAYS=90
EXECUTION_LOW_EVIDENCE_COVERAGE_THRESHOLD=25
EXECUTION_MODERATE_EVIDENCE_COVERAGE_THRESHOLD=50
EXECUTION_HIGH_EVIDENCE_COVERAGE_THRESHOLD=75
MARKET_DATA_PROVIDER=disabled
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
DATABENTO_SCHEMA=ohlcv-1m
DATABENTO_COST_CHECK_ENABLED=true
DATABENTO_MAX_REQUEST_COST_USD=0.05
REPLAY_DELAY_HOURS=24
REPLAY_PRE_TRADE_MINUTES=15
REPLAY_POST_TRADE_MINUTES=30
REPLAY_MAX_WINDOW_HOURS=2
REPLAY_WORKER_ENABLED=false
REPLAY_WORKER_INITIAL_DELAY_MS=60000
REPLAY_WORKER_FIXED_DELAY_MS=300000
REPLAY_CACHE_ENABLED=true

JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
JWT_EXPIRATION_MINUTES=30
JWT_EXPIRATION_MS=1800000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tradepilot_trade_memories
# Compatibility alias; QDRANT_COLLECTION takes precedence when both are set.
QDRANT_COLLECTION_NAME=tradepilot_trade_memories
TRADING_MEMORY_QDRANT_AUTO_CREATE_COLLECTION=true
TRADING_MEMORY_QDRANT_VALIDATE_ON_STARTUP=true
TRADING_MEMORY_QDRANT_EXPECTED_DISTANCE=COSINE
TRADING_MEMORY_QDRANT_CREATE_PAYLOAD_INDEXES=true
TRADING_MEMORY_RETRY_ENABLED=false
TRADING_MEMORY_RETRY_MAX_ATTEMPTS=5
TRADING_MEMORY_RETRY_INITIAL_DELAY_SECONDS=60
TRADING_MEMORY_RETRY_MAX_DELAY_SECONDS=3600
TRADING_MEMORY_RETRY_BATCH_SIZE=50

RESEND_API_KEY=
EMAIL_FROM=TradePilot Coach <no-reply@tradepilotcoach.com>
CONTACT_EMAIL=support@tradepilotcoach.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Legacy alias still supported by application.yml.
STRIPE_PRO_PRICE_ID=

SERVER_PORT=8080
DEV_AUTH_ENABLED=false
DEV_TOOLS_ENABLED=false
APP_ADMIN_ACCESS_PROTECTION=external-mfa
APP_ALLOWED_ORIGINS=https://www.tradepilotcoach.com
APP_FRONTEND_URL=https://www.tradepilotcoach.com
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_AI_ASYNC_CORE_POOL_SIZE=2
APP_AI_ASYNC_MAX_POOL_SIZE=6
APP_AI_ASYNC_QUEUE_CAPACITY=50
APP_EMAIL_ASYNC_CORE_POOL_SIZE=1
APP_EMAIL_ASYNC_MAX_POOL_SIZE=3
APP_EMAIL_ASYNC_QUEUE_CAPACITY=100
APP_HTTP_CLIENT_CONNECT_TIMEOUT=5s
APP_HTTP_CLIENT_READ_TIMEOUT=30s
RATE_LIMIT_STORE=database
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_CSV_IMPORT_MAX=6
RATE_LIMIT_CSV_IMPORT_WINDOW_SECONDS=300
RATE_LIMIT_SEO_EVENTS_MAX=120
RATE_LIMIT_SEO_EVENTS_WINDOW_SECONDS=60
RATE_LIMIT_SEO_EVENTS_MAX_CONTENT_BYTES=16384
RATE_LIMIT_BILLING_CHECKOUT_MAX=10
RATE_LIMIT_BILLING_CHECKOUT_WINDOW_SECONDS=300

GSC_ENABLED=false
GSC_PROPERTY=sc-domain:tradepilotcoach.com
GSC_SERVICE_ACCOUNT_JSON_BASE64=
GSC_MAX_ROWS_PER_QUERY=25000
GSC_CACHE_TTL_MINUTES=60
