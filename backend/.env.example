DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Render/Supabase aliases are accepted by deployment platforms, but DB_URL is the preferred Spring value.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace_me_with_supabase_password
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate

JWT_SECRET=replace_me_with_base64_32_byte_secret
JWT_EXPIRATION_MINUTES=30
JWT_EXPIRATION_MS=1800000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tradepilot.ai
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_EMAIL=support@tradepilot.app

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Legacy alias still supported by application.yml.
STRIPE_PRO_PRICE_ID=

SERVER_PORT=8080
DEV_AUTH_ENABLED=false
APP_ALLOWED_ORIGINS=https://tradepilot.app,https://www.tradepilot.app
APP_FRONTEND_URL=https://tradepilot.app
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_AI_ASYNC_CORE_POOL_SIZE=2
APP_AI_ASYNC_MAX_POOL_SIZE=6
APP_AI_ASYNC_QUEUE_CAPACITY=50
