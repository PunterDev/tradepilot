{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:app": "tsc && VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:8080/api} vite build",
    "build:ssr": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:8080/api} vite build --ssr src/prerender-entry.tsx --outDir .prerender-ssr",
    "prerender": "npm run build:ssr && node scripts/prerender-public-pages.mjs",
    "build": "npm run seo:audit && npm run build:app && npm run prerender",
    "seo:audit": "node scripts/audit-seo-routes.mjs",
    "seo:schema": "node scripts/audit-structured-data.mjs",
    "seo:links": "node scripts/audit-internal-links.mjs",
    "generate:og": "node scripts/generate-tradepilot-coach-og.mjs",
    "verify:og": "node scripts/verify-tradepilot-coach-og.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "test:manual-position": "node --test scripts/manual-position-calculator.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@vitejs/plugin-react": "6.0.1",
    "axios": "^1.17.0",
    "lightweight-charts": "^5.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
